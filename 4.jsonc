{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "android_small",
    "position": "top",
    "padding": {
      "left": 4,
      "top": 4
    }
  },
  "display": {
    "bar": {
      "char": {
        "total": "─"
      },
      "width": 10
    },
    "percent": {
      "type": 3,
      "ndigits": 2
    },
    "key": {
      "width": 12
    },
    "separator": ""
  },
  "modules": [
    {
      "type": "custom",
      "key": "╭───────────────────╮",
      "keyColor": "green"
    },
    {
      "type": "title",
      "format": "{#10}│ u0_a388@localhost │{#}",
      "outputColor": "green"
    },
    {
      "type": "custom",
      "key": "╰───────────────────╯",
      "keyColor": "green"
    },
    "break",
    {
      "type": "custom",
      "key": "╭── system ──────",
      "keyColor": "green"
    },
    {
      "type": "os",
      "key": "├ OS"
    },
    {
      "type": "host",
      "key": "├ Device"
    },
    {
      "type": "shell",
      "key": "├ Shell"
    },
    {
      "type": "terminal",
      "key": "╰ Term"
    },
    "break",
    {
      "type": "custom",
      "key": "╭── hardware ────┄",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "│ CPU"
    },
    {
      "type": "gpu",
      "key": "│ GPU"
    },
    {
      "type": "memory",
      "key": "│ RAM",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "disk",
      "key": "│ ({1})",
      "format": "{13} {1} / {2} ({3})"
    },
    {
      "type": "display",
      "key": "│ Display",
      "format": "{1}×{2}, {3}Hz [{7}]"
    },
    {
      "type": "custom",
      "key": "╰─┄"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break",
    "break"
  ]
}
