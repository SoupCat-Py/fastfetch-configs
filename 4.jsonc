{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "android_small",
    "position": "top",
    "padding": {
      "left": 8
    }
  },
  "display": {
    "bar": {
      "char": {
        "total": "─"
      },
      "width": 10
    },
    "percent": {
      "type": 3,
      "ndigits": 2
    },
    "key": {
      "width": 10
    },
    "separator": ""
  },
  "modules": [
    {
      "type": "custom",
      "key": "╭───────────────────╮"
    },
    {
      "type": "title",
      "format": "│ u0_a388@localhost │"
    },
    {
      "type": "custom",
      "key": "╰───────────────────╯"
    },
    "break",
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "host",
      "key": "Device"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "terminal",
      "key": "Term"
    },
    "break",
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU"
    },
    {
      "type": "memory",
      "key": "RAM",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "disk",
      "key": "Disk ({1})",
      "format": "{13} {1} / {2} ({3})"
    },
    {
      "type": "display",
      "key": "Display",
      "format": "{1}×{2}, {3}Hz [{7}]"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
